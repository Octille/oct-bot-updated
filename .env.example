# Discord
token=
CLIENT_ID=
# Your Discord user ID (owner-only commands like !givecoin)
OWNER_ID=460509056487129090

# MongoDB — a MongoDB Atlas connection string, or mongodb://localhost:27017/octbot
# (v3 also accepts MONGODB_URI; the database must be a replica set — Atlas always is)
MONGODB_SRV=

# v3: production | development. Outside production the bot refuses to use a hosted (Atlas)
# database unless MONGODB_DEV_URI is set (or ALLOW_LIVE_DB=true), so development never touches live data.
NODE_ENV=development
MONGODB_DEV_URI=mongodb://localhost:27018/octbot_dev?directConnection=true
ALLOW_LIVE_DB=false

# v3: comma-separated servers that `npm run deploy:guild` registers commands to (instant updates while developing)
DEV_GUILD_IDS=
# v3: the test bot's application id. deploy:global refuses to run for it without --force,
# and it shows a "test version" notice in /help and /balance
TEST_CLIENT_ID=
# v3: channel that receives error reports (optional)
ERROR_LOG_CHANNEL_ID=

# Lavalink (must match lavalink/application.yml or the LAVALINK_PASSWORD given to the Lavalink server)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Optional: Spotify links (free app keys from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: Apple Music token (leave empty, it's fetched automatically)
APPLE_MUSIC_TOKEN=

# Optional overrides for the anti-alt rules in src/content/social.ts (defaults: 30 and 3).
# Use on the test bot only; the real bot logs an error at startup if these are lower than the defaults.
# ANTI_ALT_DISCORD_DAYS=30
# ANTI_ALT_PROFILE_DAYS=3

# Seasons: when Season 1 starts (ISO date; unset = not started) and an optional length override (default 30 days)
# SEASON_1_START=2027-01-15T00:00:00Z
# SEASON_LENGTH_DAYS=30

# Relaunch date (ISO, e.g. 2026-12-15). Old !commands get a "use slash commands" notice for 30 days after it. Unset = off.
LAUNCH_DATE=
